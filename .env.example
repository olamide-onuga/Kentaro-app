# Flask Configuration Environment (development, production, testing)
FLASK_CONFIG=production

# Application Secret Key (generate a strong random 32+ character key for production)
SECRET_KEY=generate-a-strong-random-secret-key-here

# Database URL (PostgreSQL recommended for Production, SQLite supported for local)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/kentaro_db

# Admin Registration Security Key
ADMIN_REGISTRATION_KEY=kentaro-admin-secret-2026

# Paystack Payment Gateway Credentials (live or test keys)
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key_here
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

# Mail Configuration (SMTP) for Password Resets & Notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Optional: WebSockets Async Mode (defaults to eventlet in gunicorn, threading locally)
# SOCKETIO_ASYNC_MODE=eventlet
